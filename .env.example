# Server
PORT=3000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://localhost:27017/wscheme

# JWT
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRES_IN=7d

# Fraud Check Job
FRAUD_CHECK_ENABLED=true
FRAUD_CHECK_CRON=0 6,12,18,0 * * *
FRAUD_CHECK_RUN_ON_START=false

# ThunderSMS (newportal push API)
THUNDER_SMS_TEMPLATE_ID=
THUNDER_SMS_PE_ID=
THUNDER_SMS_API_KEY=
THUNDER_SMS_SENDER_ID=
THUNDER_SMS_MOBILE_NO=
